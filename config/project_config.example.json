{
  "project_name": "azure-retail-lakehouse",
  "environment": "dev",
  "storage_account": "<storage-account-name>",
  "containers": {
    "bronze": "bronze",
    "silver": "silver",
    "gold": "gold",
    "quarantine": "quarantine"
  },
  "bronze": {
    "orders": "orders/",
    "customers": "customers/customers.csv",
    "products": "products/products.csv",
    "stores": "stores/stores.csv"
  },
  "silver": {
    "orders": "orders/",
    "customers": "customers/",
    "products": "products/",
    "stores": "stores/"
  },
  "gold": {
    "fact_sales": "fact_sales/",
    "dim_customer": "dim_customer/",
    "dim_product": "dim_product/",
    "dim_store": "dim_store/",
    "dim_date": "dim_date/"
  },
  "azure_sql": {
    "server": "<server-name>.database.windows.net",
